@host = http://localhost:5080
@email = you@example.com
@accessToken = paste-access-token
@refreshToken = paste-refresh-token

### Sign-up step 1: email a 6-digit code (creates the account if new)
POST {{host}}/api/auth/email-code
Content-Type: application/json

{ "email": "{{email}}", "fullName": "Test User" }

### Verify email with the 6-digit code
POST {{host}}/api/auth/verify-email
Content-Type: application/json

{ "email": "{{email}}", "code": "123456" }

### Resend sign-up code
POST {{host}}/api/auth/resend-code
Content-Type: application/json

{ "email": "{{email}}" }

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "change-me-123" }

### Google sign-in (idToken from native Google Sign-In on the phone)
POST {{host}}/api/auth/google
Content-Type: application/json

{ "idToken": "paste-google-id-token" }

### Refresh session
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Forgot password (emails a reset code)
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{ "email": "{{email}}" }

### Reset step 2: check the code from the reset email
POST {{host}}/api/auth/verify-reset-code
Content-Type: application/json

{ "email": "{{email}}", "code": "123456" }

### Reset step 3: set the new password
POST {{host}}/api/auth/complete-reset
Content-Type: application/json

{ "resetToken": "paste-reset-token", "newPassword": "new-password-123" }

### Change password
POST {{host}}/api/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "currentPassword": "change-me-123", "newPassword": "new-password-123" }

### Set a password (accounts created with Google)
POST {{host}}/api/auth/set-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "newPassword": "new-password-123" }

### Logout
POST {{host}}/api/auth/logout
Authorization: Bearer {{accessToken}}

### Get profile
GET {{host}}/api/profile
Authorization: Bearer {{accessToken}}

### Update profile
PUT {{host}}/api/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Test User",
  "monthlyIncome": "50k_100k",
  "city": "Karachi",
  "province": "Sindh",
  "filerStatus": "filer"
}

### List linked accounts (with live balances)
GET {{host}}/api/accounts
Authorization: Bearer {{accessToken}}

### Link an account (the app generates the id; only the last 4 digits are sent)
@accountId = 3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f
POST {{host}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "{{accountId}}",
  "bankId": "meezan",
  "bankName": "Meezan Bank",
  "accountTitle": "Salary Account",
  "accountLast4": "4521",
  "balance": 50000
}

### Set what an account holds now
PUT {{host}}/api/accounts/{{accountId}}/balance
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "balance": 48000 }

### Remove an account (soft delete)
DELETE {{host}}/api/accounts/{{accountId}}
Authorization: Bearer {{accessToken}}

### List transactions (newest first; optional from, to, type, category, accountId, q, limit, cursor)
GET {{host}}/api/transactions?limit=50
Authorization: Bearer {{accessToken}}

### Create a transaction (the app generates the id; sending it again returns the same row)
@txId = 6f1c2a3e-8b4d-4c5e-9a7b-1d2e3f4a5b6c
POST {{host}}/api/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "{{txId}}",
  "type": "expense",
  "amount": 1200,
  "category": "Groceries",
  "note": "Imtiaz Supermarket",
  "accountId": "{{accountId}}",
  "date": "2026-10-10",
  "source": "manual"
}

### Get one transaction
GET {{host}}/api/transactions/{{txId}}
Authorization: Bearer {{accessToken}}

### Edit a transaction
PUT {{host}}/api/transactions/{{txId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "expense",
  "amount": 1500,
  "category": "Groceries",
  "note": "Imtiaz Supermarket",
  "accountId": "{{accountId}}",
  "date": "2026-10-10",
  "excludeFromBudget": false
}

### Split a transaction (parts must add up to the amount)
POST {{host}}/api/transactions/{{txId}}/split
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "parts": [
    { "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d", "amount": 1000, "category": "Groceries" },
    { "id": "1b2c3d4e-5f6a-4b7c-9d8e-0f1a2b3c4d5e", "amount": 500, "category": "Dining" }
  ]
}

### Delete a transaction (soft delete)
DELETE {{host}}/api/transactions/{{txId}}
Authorization: Bearer {{accessToken}}

### Undo a delete
POST {{host}}/api/transactions/{{txId}}/restore
Authorization: Bearer {{accessToken}}

### Readiness
GET {{host}}/health/ready
